{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "module": "commonjs",
    "moduleResolution": "node",
    "incremental": false,
    "jsx": "react-jsx"
  },
  "include": [
    "__tests__/**/*.ts",
    "features/verification/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.tsx"
  ]
}
